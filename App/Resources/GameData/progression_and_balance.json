  "cast_and_depth_mechanics": {
    "note": "Contrary to Phase 1 preliminary hypothesis, D0.e does NOT store 2D short[][] depth grids. Cast depth/distance is computed analytically from bobber Y coordinate on screen.",
    "horizon_min_y_formula": "Ybobber > (viewHeight / 5) + bobberBitmap.height",
    "water_vertical_span_formula": "waterHeight = viewHeight - (viewHeight / 5) - bobberBitmap.height",
    "bite_wait_seconds_formula": "int(((Ybobber - viewHeight/5 - bobberBitmap.height) * 20.0f) / waterHeight) + 15 + random.nextInt(50)",
    "cast_distance_factor_v3_formula": "v3 = int(((waterHeight - (Ybobber - viewHeight/5 - bobberBitmap.height)) / waterHeight) * 10.0f + 1.0f)  // range 1 (shore) .. 11 (far horizon)",
    "weight_bracket_scaling": {
      "roll": "r = random.nextInt(d0d.g[13])  // 0..999",
      "tier_1_small": {
        "condition": "r in [50..350] or r in [350..400] or r in [400..700]",
        "near_shore_v3_lt_4": "weight in [minW, minW + (maxW - minW) * 40 / 100]",
        "far_cast_v3_ge_4": "weight in [minW, minW + (maxW - minW) * (v3 + 40) / 100]"
      },
      "tier_2_medium": {
        "condition": "r in [700..730) or r in (730..995)",
        "near_shore_v3_lt_4": "weight in [minW + range*40/100, minW + range*60/100]",
        "far_cast_v3_ge_4": "weight in [minW + range*(v3+40)/100, minW + range*(v3+60)/100]"
      },
      "tier_3_large": {
        "condition": "r in (995..1000)",
        "near_shore_v3_lt_4": "weight in [minW + range*60/100, minW + range*80/100]",
        "far_cast_v3_ge_4": "weight in [minW + range*(v3+60)/100, minW + range*(v3+80)/100]"
      },
      "tier_4_trophy": {
        "condition": "r > 995 (when g[12]=995)",
        "all_casts": "weight in [minW + range*80/100, maxW]"
      }
    }
  },
